digraph QualityModel {
  graph [
    rankdir=LR,
    bgcolor="transparent",
    pad="0.14",
    margin="0.03",
    nodesep="0.22",
    ranksep="0.82",
    splines=ortho,
    outputorder=edgesfirst,
    ordering=out
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="DejaVu Sans",
    fontsize=10.5,
    color="#81998d",
    fontcolor="#1f3d31",
    penwidth=1.05,
    margin="0.18,0.11"
  ];

  edge [
    dir=none,
    color="#70a187",
    penwidth=1.15
  ];

  Root [
    label="Authenticator Employment\nQuality Model",
    fillcolor="#1f513f",
    fontcolor="white",
    color="#1f513f",
    fontsize=13,
    penwidth=1.5,
    width=2.40,
    height=0.72
  ];

  // Quality factors
  Usability [label="Usability", fillcolor="#dff3e9", color="#287a58", penwidth=1.5, width=1.95, style="rounded,filled,dashed"];
  Security  [label="Security", fillcolor="#dff3e9", color="#287a58", penwidth=1.5, width=1.95, style="rounded,filled,dashed"];
  
  // Quality subfactors
  MemorizationEffortlessness [label="Memorization effortlessness", fillcolor="white", width=2.08, style="rounded,filled,dashed", penwidth=1.3];
  EaseOfUse                  [label="Ease of use",                 fillcolor="white", width=2.08, style="rounded,filled,dashed", penwidth=1.3];
  Accuracy                   [label="Accuracy",                    fillcolor="white", width=2.08, style="rounded,filled,dashed", penwidth=1.3];
  Availability               [label="Availability",                fillcolor="white", width=2.08, style="rounded,filled,dashed", penwidth=1.3];
  Accessibility              [label="Accessibility",               fillcolor="white", width=2.08, style="rounded,filled,dashed", penwidth=1.3];


  ThreatSensitivity          [label="Threat sensitivity",          fillcolor="white", width=2.08, style="rounded,filled,dashed", penwidth=1.3];
  ImpairmentRisks            [label="Impairment risks",            fillcolor="white", width=2.08, style="rounded,filled,dashed", penwidth=1.3];


  Root -> Usability;
  Root -> Security;

  Usability -> MemorizationEffortlessness;
  Usability -> EaseOfUse;
  Usability -> Accuracy;
  Usability -> Availability;
  Usability -> Accessibility;

  Security -> ThreatSensitivity;
  Security -> ImpairmentRisks;
}
