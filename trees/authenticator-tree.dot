digraph QualityModel {
  graph [
    rankdir=LR,
    bgcolor="transparent",
    pad="0.14",
    margin="0.03",
    nodesep="0.22",
    ranksep="0.82",
    splines=ortho,
    outputorder=edgesfirst,
    ordering=out
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="DejaVu Sans",
    fontsize=10.5,
    color="#a38b75",
    fontcolor="#4b311c",
    penwidth=1.05,
    margin="0.18,0.11"
  ];

  edge [
    dir=none,
    color="#b18559",
    penwidth=1.15
  ];

  Root [
    label="Authenticator\nQuality Model",
    fillcolor="#6e3e11",
    fontcolor="white",
    color="#6e3e11",
    fontsize=13,
    penwidth=1.5,
    width=2.18,
    height=0.72
  ];

  // Quality factors
  Usability   [label="Usability", fillcolor="#fff0dd", color="#9a5718", penwidth=1.3, width=1.84];
  Security    [label="Security",  fillcolor="#fff0dd", color="#9a5718", penwidth=1.3, width=1.84];

  // Quality subfactors
  EaseOfMemorization         [label="Ease of memorization",        fillcolor="white", width=2.12];
  EaseOfUse                  [label="Ease of use",                 fillcolor="white", width=2.12];
  Accuracy                   [label="Accuracy",                    fillcolor="white", width=2.12];
  Availability               [label="Availability",                fillcolor="white", width=2.12];
  Accessibility              [label="Accessibility",               fillcolor="white", width=2.12];

  ThreatSensitivity          [label="Threat sensitivity",          fillcolor="white", width=2.12];
  ImpairmentRisks            [label="Impairment risks",            fillcolor="white", width=2.12];

  Root -> Usability;
  Root -> Security;

  Usability -> EaseOfMemorization;
  Usability -> EaseOfUse;
  Usability -> Accuracy;
  Usability -> Availability;
  Usability -> Accessibility;

  Security -> ThreatSensitivity;
  Security -> ImpairmentRisks;
}
